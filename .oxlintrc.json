{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "perf": "error",
        "suspicious": "error"
    },
    "env": {
        "node": true
    },
    "ignorePatterns": ["coverage", "dist", "node_modules"],
    "options": {
        "denyWarnings": true,
        "reportUnusedDisableDirectives": "error"
    },
    "rules": {
        "no-await-in-loop": "off"
    }
}
