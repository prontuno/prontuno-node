{
    "name": "prontuno",
    "version": "0.2.0",
    "description": "Official Node.js SDK for the Prontuno email API",
    "keywords": [
        "email",
        "prontuno",
        "sdk",
        "transactional-email"
    ],
    "homepage": "https://github.com/prontuno/prontuno-node#readme",
    "bugs": {
        "url": "https://github.com/prontuno/prontuno-node/issues"
    },
    "license": "MIT",
    "author": "Prontuno Team <support@prontuno.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prontuno/prontuno-node.git"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsup",
        "check": "npm run format:check && npm run lint && npm run typecheck",
        "fix": "npm run lint:fix && npm run format",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "test": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/index.js --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=99 \"test/*.test.mjs\"",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
        "prepublishOnly": "npm run check && npm test"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.78.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@11.17.0",
    "allowScripts": {
        "esbuild": true
    }
}
